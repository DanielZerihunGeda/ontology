@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix kg: <https://example.org/ontology#>.

<https://example.org/ontology> a owl:Ontology;
    rdfs:label "Knowledge Graph";
    rdfs:comment "Construction contract administration. Generated from model/model.tsv; the Neo4j model is the master. Lists are stored as text here; relationship properties are listed in the relationship comment.";
    owl:versionInfo "1.0".

kg:Project a owl:Class;
    rdfs:label "Project";
    rdfs:comment "A construction project. Hub that every record links to.".

kg:Project__id a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "id";
    rdfs:range xsd:string;
    rdfs:comment "Unique identifier of the Project.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Project__name a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "name";
    rdfs:range xsd:string;
    rdfs:comment "Official project name.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Project__aliases a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "aliases";
    rdfs:range xsd:string;
    rdfs:comment "Short names, abbreviations or former names of the project. Multi-valued.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Project__summary a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "summary";
    rdfs:range xsd:string;
    rdfs:comment "Short summary of the project scope. Source text for summaryEmbedding.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Project__status a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "status";
    rdfs:range xsd:string;
    rdfs:comment "Current project status. Allowed values: Tendering, Ongoing, Suspended, Completed, Terminated.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:location a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "location";
    rdfs:range xsd:string;
    rdfs:comment "City or region where the project is built.".

kg:startDate a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "startDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Actual start date.".

kg:plannedCompletionDate a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "plannedCompletionDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Planned completion date.".

kg:actualCompletionDate a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "actualCompletionDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Actual completion date.".

kg:durationDays a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "durationDays";
    rdfs:range xsd:integer;
    rdfs:comment "Planned duration in calendar days.".

kg:areaSqm a owl:DatatypeProperty;
    rdfs:domain kg:Project;
    rdfs:label "areaSqm";
    rdfs:range xsd:decimal;
    rdfs:comment "Project area in square metres.".

kg:Organization a owl:Class;
    rdfs:label "Organization";
    rdfs:comment "A company or public body taking part in projects as client, contractor or consultant. Its role is on the relationship to Project.".

kg:Organization__id a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "id";
    rdfs:range xsd:string;
    rdfs:comment "Unique identifier of the Organization.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Organization__name a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "name";
    rdfs:range xsd:string;
    rdfs:comment "Official registered name.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Organization__aliases a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "aliases";
    rdfs:range xsd:string;
    rdfs:comment "Abbreviations, trading names or former names. Multi-valued.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:clientType a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "clientType";
    rdfs:range xsd:string;
    rdfs:comment "Client classification. Set for organizations that act as client. Allowed values: Government, Public Enterprise, Private, NGO / International Organization, Individual.".

kg:address a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "address";
    rdfs:range xsd:string;
    rdfs:comment "Full postal or office address.".

kg:city a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "city";
    rdfs:range xsd:string;
    rdfs:comment "City where the organization is based.".

kg:country a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "country";
    rdfs:range xsd:string;
    rdfs:comment "Country where the organization is based.".

kg:email a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "email";
    rdfs:range xsd:string;
    rdfs:comment "Main contact email.".

kg:phoneNumber a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "phoneNumber";
    rdfs:range xsd:string;
    rdfs:comment "Main contact phone number.".

kg:taxId a owl:DatatypeProperty;
    rdfs:domain kg:Organization;
    rdfs:label "taxId";
    rdfs:range xsd:string;
    rdfs:comment "Tax identification number (TIN).".

kg:Letter a owl:Class;
    rdfs:label "Letter";
    rdfs:comment "Project correspondence, incoming or outgoing.".

kg:Letter__id a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "id";
    rdfs:range xsd:string;
    rdfs:comment "Unique identifier of the Letter.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Letter__referenceNumber a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "referenceNumber";
    rdfs:range xsd:string;
    rdfs:comment "Letter reference number, exactly as printed.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Letter__referenceNumberNorm a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "referenceNumberNorm";
    rdfs:range xsd:string;
    rdfs:comment "referenceNumber upper-cased with spaces and separators removed, for exact lookup.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Letter__issueDate a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "issueDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Date written on the letter.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:direction a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "direction";
    rdfs:range xsd:string;
    rdfs:comment "Incoming or outgoing, seen from our organization. Allowed values: Incoming, Outgoing.".

kg:subject a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "subject";
    rdfs:range xsd:string;
    rdfs:comment "Subject line of the letter.".

kg:Letter__summary a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "summary";
    rdfs:range xsd:string;
    rdfs:comment "Short summary of the letter content. Source text for summaryEmbedding.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:senderName a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "senderName";
    rdfs:range xsd:string;
    rdfs:comment "Sender as written on the letter. The resolved party is linked by SENT_BY.".

kg:recipientNames a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "recipientNames";
    rdfs:range xsd:string;
    rdfs:comment "Recipients as written on the letter, including copied parties. Resolved parties are linked by ADDRESSED_TO. Multi-valued.".

kg:Letter__sourceUrl a owl:DatatypeProperty;
    rdfs:domain kg:Letter;
    rdfs:label "sourceUrl";
    rdfs:range xsd:string;
    rdfs:comment "Link to the original source document. Context for the agent to cite or open; not searched.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:EOTClaim a owl:Class;
    rdfs:label "EOTClaim";
    rdfs:comment "Extension of time claim. Contract baseline values are snapshots as stated in the claim.".

kg:EOTClaim__id a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "id";
    rdfs:range xsd:string;
    rdfs:comment "Unique identifier of the EOTClaim.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:EOTClaim__submittedDate a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "submittedDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Date the claim was submitted.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:EOTClaim__status a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "status";
    rdfs:range xsd:string;
    rdfs:comment "Decision status of the claim. Allowed values: Submitted, Under Review, Approved, Partially Approved, Rejected.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:EOTClaim__summary a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "summary";
    rdfs:range xsd:string;
    rdfs:comment "Short summary of the claim: causes, events and key takeaways. Source text for summaryEmbedding.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:contractSigningDate a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "contractSigningDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Contract signing date as stated in the claim.".

kg:siteHandoverDate a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "siteHandoverDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Site handover date as stated in the claim.".

kg:commencementDate a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "commencementDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Commencement date as stated in the claim.".

kg:originalContractPrice a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "originalContractPrice";
    rdfs:range xsd:decimal;
    rdfs:comment "Original accepted contract price as stated in the claim.".

kg:EOTClaim__currency a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "currency";
    rdfs:range xsd:string;
    rdfs:comment "ISO 4217 currency code of the amounts, e.g. ETB.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:EOTClaim__includesVAT a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "includesVAT";
    rdfs:range xsd:boolean;
    rdfs:comment "True if the amounts include VAT.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:originalDurationDays a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "originalDurationDays";
    rdfs:range xsd:integer;
    rdfs:comment "Original contract duration in calendar days.".

kg:originalCompletionDate a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "originalCompletionDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Original contractual completion date.".

kg:previouslyApprovedExtensionDays a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "previouslyApprovedExtensionDays";
    rdfs:range xsd:integer;
    rdfs:comment "Cumulative days approved under earlier claims.".

kg:requestedExtensionDays a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "requestedExtensionDays";
    rdfs:range xsd:integer;
    rdfs:comment "Days requested by this claim.".

kg:requestedCompletionDate a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "requestedCompletionDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Completion date this claim asks for. Not an approved date.".

kg:approvedExtensionDays a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "approvedExtensionDays";
    rdfs:range xsd:integer;
    rdfs:comment "Days granted for this claim. Empty until decided.".

kg:EOTClaim__sourceUrl a owl:DatatypeProperty;
    rdfs:domain kg:EOTClaim;
    rdfs:label "sourceUrl";
    rdfs:range xsd:string;
    rdfs:comment "Link to the original source document. Context for the agent to cite or open; not searched.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Agreement a owl:Class;
    rdfs:label "Agreement";
    rdfs:comment "A signed agreement between project parties, recorded with its clause reference.".

kg:Agreement__id a owl:DatatypeProperty;
    rdfs:domain kg:Agreement;
    rdfs:label "id";
    rdfs:range xsd:string;
    rdfs:comment "Unique identifier of the Agreement.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:clauseNumber a owl:DatatypeProperty;
    rdfs:domain kg:Agreement;
    rdfs:label "clauseNumber";
    rdfs:range xsd:string;
    rdfs:comment "Clause number, exactly as printed.".

kg:clauseNumberNorm a owl:DatatypeProperty;
    rdfs:domain kg:Agreement;
    rdfs:label "clauseNumberNorm";
    rdfs:range xsd:string;
    rdfs:comment "clauseNumber upper-cased with spaces and separators removed, for exact lookup.".

kg:signedDate a owl:DatatypeProperty;
    rdfs:domain kg:Agreement;
    rdfs:label "signedDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Date the agreement was signed.".

kg:clauseDate a owl:DatatypeProperty;
    rdfs:domain kg:Agreement;
    rdfs:label "clauseDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Date of the clause.".

kg:witnessNames a owl:DatatypeProperty;
    rdfs:domain kg:Agreement;
    rdfs:label "witnessNames";
    rdfs:range xsd:string;
    rdfs:comment "Names of the witnesses, as written. Multi-valued.".

kg:Agreement__summary a owl:DatatypeProperty;
    rdfs:domain kg:Agreement;
    rdfs:label "summary";
    rdfs:range xsd:string;
    rdfs:comment "Short summary of what the agreement and clause say. Source text for summaryEmbedding.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Agreement__sourceUrl a owl:DatatypeProperty;
    rdfs:domain kg:Agreement;
    rdfs:label "sourceUrl";
    rdfs:range xsd:string;
    rdfs:comment "Link to the original source document. Context for the agent to cite or open; not searched.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Proposal a owl:Class;
    rdfs:label "Proposal";
    rdfs:comment "A bid or proposal submitted for a project.".

kg:Proposal__id a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "id";
    rdfs:range xsd:string;
    rdfs:comment "Unique identifier of the Proposal.";
