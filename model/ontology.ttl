kg:Proposal__referenceNumber a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "referenceNumber";
    rdfs:range xsd:string;
    rdfs:comment "Bid reference number, exactly as printed.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Proposal__referenceNumberNorm a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "referenceNumberNorm";
    rdfs:range xsd:string;
    rdfs:comment "referenceNumber upper-cased with spaces and separators removed, for exact lookup.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Proposal__title a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "title";
    rdfs:range xsd:string;
    rdfs:comment "Title of the bid.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Proposal__status a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "status";
    rdfs:range xsd:string;
    rdfs:comment "Outcome status of the bid. Allowed values: Draft, Submitted, Won, Lost, Withdrawn.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Proposal__submittedDate a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "submittedDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Date the bid was submitted.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:validUntil a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "validUntil";
    rdfs:range xsd:dateTime;
    rdfs:comment "Last day the bid remains valid.".

kg:proposedAmount a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "proposedAmount";
    rdfs:range xsd:decimal;
    rdfs:comment "Total amount offered in the bid.".

kg:Proposal__currency a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "currency";
    rdfs:range xsd:string;
    rdfs:comment "ISO 4217 currency code of the amounts, e.g. ETB.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Proposal__includesVAT a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "includesVAT";
    rdfs:range xsd:boolean;
    rdfs:comment "True if the amounts include VAT.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Proposal__summary a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "summary";
    rdfs:range xsd:string;
    rdfs:comment "Short summary of the proposal. Source text for summaryEmbedding.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Proposal__sourceUrl a owl:DatatypeProperty;
    rdfs:domain kg:Proposal;
    rdfs:label "sourceUrl";
    rdfs:range xsd:string;
    rdfs:comment "Link to the original source document. Context for the agent to cite or open; not searched.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Drawing a owl:Class;
    rdfs:label "Drawing";
    rdfs:comment "A project drawing sheet.".

kg:Drawing__id a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "id";
    rdfs:range xsd:string;
    rdfs:comment "Unique identifier of the Drawing.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Drawing__referenceNumber a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "referenceNumber";
    rdfs:range xsd:string;
    rdfs:comment "Drawing number as shown in the title block, exactly as printed.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Drawing__referenceNumberNorm a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "referenceNumberNorm";
    rdfs:range xsd:string;
    rdfs:comment "referenceNumber upper-cased with spaces and separators removed, for exact lookup.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Drawing__title a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "title";
    rdfs:range xsd:string;
    rdfs:comment "Drawing title.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:discipline a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "discipline";
    rdfs:range xsd:string;
    rdfs:comment "Engineering discipline of the drawing. Allowed values: Architectural, Structural, Civil Engineering, Mechanical, Plumbing, Interior Design, Geotechnical, Electrical, Infrastructure.".

kg:Drawing__revision a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "revision";
    rdfs:range xsd:string;
    rdfs:comment "Revision code, e.g. A, B, 01.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:Drawing__issueDate a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "issueDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Date the drawing revision was issued.";
