kg:designerName a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "designerName";
    rdfs:range xsd:string;
    rdfs:comment "Designer as written in the title block. The resolved party is linked by DESIGNED_BY.".

kg:Drawing__sourceUrl a owl:DatatypeProperty;
    rdfs:domain kg:Drawing;
    rdfs:label "sourceUrl";
    rdfs:range xsd:string;
    rdfs:comment "Link to the original source document. Context for the agent to cite or open; not searched.";
