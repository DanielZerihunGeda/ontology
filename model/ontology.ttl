kg:FinancialRecord a owl:Class;
    rdfs:label "FinancialRecord";
    rdfs:comment "An individual financial document, transaction, obligation, allocation or reporting record. The sole financial node label; recordType distinguishes its nature. BOQ remains independent. Legacy Payment records reconcile to recordType=Payment while preserving IDs and provenance.".

kg:FinancialRecord__id a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "id";
    rdfs:range xsd:string;
    rdfs:comment "Unique stable identifier of the FinancialRecord. Preserve confirmed existing IDs during reconciliation and migration.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:recordType a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "recordType";
    rdfs:range xsd:string;
    rdfs:comment "Required financial record type. All listed types use this single node label; BOQ remains separate. Allowed values: Invoice, Payment, Payroll, Expense, Cost, Budget, CreditNote, FinancialStatement, PurchaseOrder, Receipt, Other.".

kg:FinancialRecord__referenceNumber a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "referenceNumber";
    rdfs:range xsd:string;
    rdfs:comment "Financial record reference exactly as printed; preserve leading zeros.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:FinancialRecord__referenceNumberNorm a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "referenceNumberNorm";
    rdfs:range xsd:string;
    rdfs:comment "referenceNumber upper-cased with only ASCII A-Z and 0-9 retained.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:description a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "description";
    rdfs:range xsd:string;
    rdfs:comment "Source-supported description of the individual financial record.".

kg:category a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "category";
    rdfs:range xsd:string;
    rdfs:comment "Financial classification of the record, distinct from recordType.".

kg:amount a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "amount";
    rdfs:range xsd:decimal;
    rdfs:comment "Primary source-reported monetary amount according to recordType. Preserve the distinction between invoiced, paid, incurred and allocated amounts.".

kg:FinancialRecord__currency a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "currency";
    rdfs:range xsd:string;
    rdfs:comment "Explicit valid uppercase ISO 4217 currency code.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:taxAmount a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "taxAmount";
    rdfs:range xsd:decimal;
    rdfs:comment "Tax amount when applicable and explicitly evidenced.".

kg:FinancialRecord__includesVAT a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "includesVAT";
    rdfs:range xsd:boolean;
    rdfs:comment "Whether the relevant amount includes VAT, only when evidenced; unstated remains unknown.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:FinancialRecord__status a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "status";
    rdfs:range xsd:string;
    rdfs:comment "Source-supported financial record status; no closed enum is specified.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:effectiveDate a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "effectiveDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Date of the relevant financial event, e.g. invoice issue, payment, expense or payroll date.".

kg:dueDate a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "dueDate";
    rdfs:range xsd:dateTime;
    rdfs:comment "Due date of the financial obligation, when applicable and evidenced.".

kg:FinancialRecord__periodStart a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "periodStart";
    rdfs:range xsd:dateTime;
    rdfs:comment "Start of the applicable financial or reporting period.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:FinancialRecord__periodEnd a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "periodEnd";
    rdfs:range xsd:dateTime;
    rdfs:comment "End of the applicable financial or reporting period.";
    <urn:fabric-internal:qualifiedPropertyName> "true".

kg:paymentMethod a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "paymentMethod";
    rdfs:range xsd:string;
    rdfs:comment "Source-supported payment method, when applicable.".

kg:transactionReference a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "transactionReference";
    rdfs:range xsd:string;
    rdfs:comment "Source transaction reference exactly as recorded.".

kg:interimNumber a owl:DatatypeProperty;
    rdfs:domain kg:FinancialRecord;
    rdfs:label "interimNumber";
    rdfs:range xsd:integer;
