@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix fabric: <https://example.org/ontology#>.

<https://example.org/ontology> a owl:Ontology;
                                    rdfs:label "Ontology_1".
fabric:AgreementClause a owl:Class;
                       rdfs:comment "Agreement between the main contractor and a sub-contractor, recorded together with its clause references.";
                       rdfs:label "AgreementClause";
                       <urn:fabric-internal:name> "AgreementClause".
fabric:BELONGS_TO a owl:ObjectProperty;
                  rdfs:domain fabric:BOQ;
                  rdfs:label "BELONGS_TO";
                  rdfs:range fabric:Project.
fabric:BELONGS_TO_2 a owl:ObjectProperty;
                    rdfs:domain fabric:Project;
                    rdfs:label "BELONGS_TO_2";
                    rdfs:range fabric:AgreementClause.
fabric:BELONGS_TO_3 a owl:ObjectProperty;
                    rdfs:domain fabric:EOTClaim;
                    rdfs:label "BELONGS_TO_3";
                    rdfs:range fabric:Project.
fabric:BELONGS_TO_4 a owl:ObjectProperty;
                    rdfs:domain fabric:Payment;
                    rdfs:label "BELONGS_TO_4";
                    rdfs:range fabric:Project.
fabric:BOQ a owl:Class;
           rdfs:comment "The priced Bill of Quantities of a project, recorded at total level.";
           rdfs:label "BOQ";
           <urn:fabric-internal:name> "BOQ".
fabric:Client a owl:Class;
              rdfs:comment "The employer or client that procures the project. Client type is a key classifier and must be taken from the controlled list.";
              rdfs:label "Client";
              <urn:fabric-internal:name> "Client".
fabric:Consultant a owl:Class;
                  rdfs:label "Consultant";
                  <urn:fabric-internal:name> "Consultant".
fabric:DELIEVERED_BY_2 a owl:ObjectProperty;
                       rdfs:domain fabric:Letter;
                       rdfs:label "DELIEVERED_BY_2";
                       rdfs:range fabric:Consultant.
fabric:DELIEVERED_BY_3 a owl:ObjectProperty;
                       rdfs:domain fabric:Letter;
                       rdfs:label "DELIEVERED_BY_3";
                       rdfs:range fabric:Subcontractor.
fabric:DELIEVERED_BY_5 a owl:ObjectProperty;
                       rdfs:domain fabric:Letter;
                       rdfs:label "DELIEVERED_BY_5";
                       rdfs:range fabric:Client.
fabric:DELIVERED_TO a owl:ObjectProperty;
                    rdfs:domain fabric:Letter;
                    rdfs:label "DELIVERED_TO";
                    rdfs:range fabric:Consultant.
fabric:DELIVERED_TO_2 a owl:ObjectProperty;
                      rdfs:domain fabric:Letter;
                      rdfs:label "DELIVERED_TO_2";
                      rdfs:range fabric:Client.
fabric:DELIVERED_TO_3 a owl:ObjectProperty;
                      rdfs:domain fabric:Letter;
                      rdfs:label "DELIVERED_TO_3";
                      rdfs:range fabric:Subcontractor.
fabric:Drawing a owl:Class;
               rdfs:label "Drawing";
               <urn:fabric-internal:name> "Drawing".
fabric:EOTClaim a owl:Class;
                rdfs:comment "A request for extension of time. Contract baseline values are stored as a snapshot as stated in the claim.";
                rdfs:label "EOTClaim";
                <urn:fabric-internal:name> "EOTClaim".
fabric:HAS_CONSULTANT a owl:ObjectProperty;
                      rdfs:domain fabric:Consultant;
                      rdfs:label "HAS_CONSULTANT";
                      rdfs:range fabric:Project.
fabric:HAS_DRAWING a owl:ObjectProperty;
                   rdfs:domain fabric:Project;
                   rdfs:label "HAS_DRAWING";
                   rdfs:range fabric:Drawing.
fabric:HAS_PROGRESS_REPORT a owl:ObjectProperty;
                           rdfs:domain fabric:ProgressReport;
                           rdfs:label "HAS_PROGRESS_REPORT";
                           rdfs:range fabric:Project.
fabric:HAS_SCHEDULE a owl:ObjectProperty;
                    rdfs:domain fabric:Project;
                    rdfs:label "HAS_SCHEDULE";
                    rdfs:range fabric:Schedule.
fabric:Letter a owl:Class;
              rdfs:comment "Project correspondence, incoming or outgoing.";
              rdfs:label "Letter";
              <urn:fabric-internal:name> "Letter".
fabric:Payment a owl:Class;
               rdfs:comment "An executed interim payment (1st, 2nd, 3rd, ...). Records actual payments only, not proposed amounts or BOQ values.";
               rdfs:label "Payment";
               <urn:fabric-internal:name> "Payment".
fabric:ProgressReport a owl:Class;
                      rdfs:comment "Planned and executed totals keyed to a report date. Records are kept per report date; duplicate or incomplete records are not merged or aggregated.";
                      rdfs:label "ProgressReport";
                      <urn:fabric-internal:name> "ProgressReport".
fabric:Project a owl:Class;
               rdfs:comment "A construction project. Central entity of the graph.";
               rdfs:label "Project";
               <urn:fabric-internal:name> "Project".
fabric:SUBMITTED_BY_2 a owl:ObjectProperty;
                      rdfs:domain fabric:EOTClaim;
                      rdfs:label "SUBMITTED_BY_2";
                      rdfs:range fabric:Subcontractor.
fabric:Schedule a owl:Class;
                rdfs:label "Schedule";
                <urn:fabric-internal:name> "Schedule".
fabric:Subcontractor a owl:Class;
                     rdfs:label "Subcontractor";
                     <urn:fabric-internal:name> "Subcontractor".
fabric:agreementDate a owl:DatatypeProperty;
                     rdfs:domain fabric:AgreementClause;
                     rdfs:label "agreementDate";
                     rdfs:range xsd:dateTime;
                     <urn:fabric-internal:name> "agreementDate".
fabric:amountPaid a owl:DatatypeProperty;
                  rdfs:comment "Executed (actually paid) amount.";
                  rdfs:domain fabric:Payment;
                  rdfs:label "amountPaid";
                  rdfs:range xsd:decimal;
                  <urn:fabric-internal:name> "amountPaid".
fabric:boqDate a owl:DatatypeProperty;
               rdfs:domain fabric:BOQ;
               rdfs:label "boqDate";
               rdfs:range xsd:dateTime;
               <urn:fabric-internal:name> "boqDate".
fabric:boqTotalAmount a owl:DatatypeProperty;
                      rdfs:comment "Aggregate total of the priced BOQ.";
                      rdfs:domain fabric:BOQ;
                      rdfs:label "boqTotalAmount";
                      rdfs:range xsd:decimal;
                      <urn:fabric-internal:name> "boqTotalAmount".
fabric:claimDate a owl:DatatypeProperty;
                 rdfs:domain fabric:EOTClaim;
                 rdfs:label "claimDate";
                 rdfs:range xsd:dateTime;
                 <urn:fabric-internal:name> "claimDate".
fabric:clauseDate a owl:DatatypeProperty;
                  rdfs:domain fabric:AgreementClause;
                  rdfs:label "clauseDate";
                  rdfs:range xsd:dateTime;
                  <urn:fabric-internal:name> "clauseDate".
fabric:clauseNumber a owl:DatatypeProperty;
                    rdfs:domain fabric:AgreementClause;
                    rdfs:label "clauseNumber";
                    rdfs:range xsd:string;
                    <urn:fabric-internal:name> "clauseNumber".
fabric:clientType a owl:DatatypeProperty;
                  rdfs:comment "Key classifier. Must be one of the controlled values.";
                  rdfs:domain fabric:Client;
                  rdfs:label "clientType";
                  rdfs:range xsd:string;
                  <urn:fabric-internal:name> "clientType".
fabric:commencementDate a owl:DatatypeProperty;
                        rdfs:domain fabric:EOTClaim;
                        rdfs:label "commencementDate";
                        rdfs:range xsd:dateTime;
                        <urn:fabric-internal:name> "commencementDate".
fabric:consultantRole a owl:DatatypeProperty;
                      rdfs:domain fabric:Consultant;
                      rdfs:label "consultantRole";
                      rdfs:range xsd:string;
                      <urn:fabric-internal:name> "consultantRole".
fabric:contractDurationDays a owl:DatatypeProperty;
                            rdfs:domain fabric:EOTClaim;
                            rdfs:label "contractDurationDays";
                            rdfs:range xsd:string;
                            <urn:fabric-internal:name> "contractDurationDays".
fabric:contractSigningDate a owl:DatatypeProperty;
                           rdfs:domain fabric:EOTClaim;
                           rdfs:label "contractSigningDate";
                           rdfs:range xsd:dateTime;
                           <urn:fabric-internal:name> "contractSigningDate".
fabric:dataDate a owl:DatatypeProperty;
                rdfs:comment "Status date the schedule is valid for.";
                rdfs:domain fabric:Schedule;
                rdfs:label "dataDate";
                rdfs:range xsd:dateTime;
                <urn:fabric-internal:name> "dataDate".
fabric:designer a owl:DatatypeProperty;
                rdfs:comment "Firm or person that produced the drawing.";
                rdfs:domain fabric:Drawing;
                rdfs:label "designer";
                rdfs:range xsd:string;
                <urn:fabric-internal:name> "designer".
fabric:direction a owl:DatatypeProperty;
                 rdfs:domain fabric:Letter;
                 rdfs:label "direction";
                 rdfs:range xsd:string;
                 <urn:fabric-internal:name> "direction".
fabric:discipline a owl:DatatypeProperty;
                  rdfs:domain fabric:Drawing;
                  rdfs:label "discipline";
                  rdfs:range xsd:string;
                  <urn:fabric-internal:name> "discipline".
fabric:drawingNumber a owl:DatatypeProperty;
                     rdfs:domain fabric:Drawing;
                     rdfs:label "drawingNumber";
                     rdfs:range xsd:string;
                     <urn:fabric-internal:name> "drawingNumber".
fabric:drawingTitle a owl:DatatypeProperty;
                    rdfs:domain fabric:Drawing;
                    rdfs:label "drawingTitle";
                    rdfs:range xsd:string;
                    <urn:fabric-internal:name> "drawingTitle".
fabric:durationDays a owl:DatatypeProperty;
                    rdfs:comment "Planned project duration in calendar days.";
                    rdfs:domain fabric:Project;
                    rdfs:label "durationDays";
                    rdfs:range xsd:string;
                    <urn:fabric-internal:name> "durationDays".
fabric:executedTotal a owl:DatatypeProperty;
                     rdfs:domain fabric:ProgressReport;
                     rdfs:label "executedTotal";
                     rdfs:range xsd:decimal;
                     <urn:fabric-internal:name> "executedTotal".
fabric:interimNumber a owl:DatatypeProperty;
                     rdfs:comment "Sequence of the interim payment: 1 = 1st, 2 = 2nd, ...";
                     rdfs:domain fabric:Payment;
                     rdfs:label "interimNumber";
                     rdfs:range xsd:string;
                     <urn:fabric-internal:name> "interimNumber".
fabric:issueDate a owl:DatatypeProperty;
                 rdfs:domain fabric:Drawing;
                 rdfs:label "issueDate";
                 rdfs:range xsd:dateTime;
                 <urn:fabric-internal:name> "issueDate".
fabric:keyTakeaways a owl:DatatypeProperty;
                    rdfs:domain fabric:EOTClaim;
                    rdfs:label "keyTakeaways";
                    rdfs:range xsd:string;
                    <urn:fabric-internal:name> "keyTakeaways".
fabric:letterDate a owl:DatatypeProperty;
                  rdfs:domain fabric:Letter;
                  rdfs:label "letterDate";
                  rdfs:range xsd:dateTime;
                  <urn:fabric-internal:name> "letterDate".
fabric:letterReference a owl:DatatypeProperty;
                       rdfs:domain fabric:Letter;
                       rdfs:label "letterReference";
                       rdfs:range xsd:string;
                       <urn:fabric-internal:name> "letterReference".
fabric:mainContractorWitness a owl:DatatypeProperty;
                             rdfs:domain fabric:AgreementClause;
                             rdfs:label "mainContractorWitness";
                             rdfs:range xsd:string;
                             <urn:fabric-internal:name> "mainContractorWitness".
fabric:originalCompletionDate a owl:DatatypeProperty;
                              rdfs:domain fabric:EOTClaim;
                              rdfs:label "originalCompletionDate";
                              rdfs:range xsd:dateTime;
                              <urn:fabric-internal:name> "originalCompletionDate".
fabric:originalContractPriceInclVAT a owl:DatatypeProperty;
                                    rdfs:domain fabric:EOTClaim;
                                    rdfs:label "originalContractPriceInclVAT";
                                    rdfs:range xsd:decimal;
                                    <urn:fabric-internal:name> "originalContractPriceInclVAT".
fabric:paymentDate a owl:DatatypeProperty;
                   rdfs:comment "Date the payment was executed.";
                   rdfs:domain fabric:Payment;
                   rdfs:label "paymentDate";
                   rdfs:range xsd:dateTime;
                   <urn:fabric-internal:name> "paymentDate".
fabric:plannedFinishDate a owl:DatatypeProperty;
                         rdfs:domain fabric:Schedule;
                         rdfs:label "plannedFinishDate";
                         rdfs:range xsd:dateTime;
                         <urn:fabric-internal:name> "plannedFinishDate".
fabric:plannedStartDate a owl:DatatypeProperty;
                        rdfs:domain fabric:Schedule;
                        rdfs:label "plannedStartDate";
                        rdfs:range xsd:dateTime;
                        <urn:fabric-internal:name> "plannedStartDate".
fabric:plannedTotal a owl:DatatypeProperty;
                    rdfs:domain fabric:ProgressReport;
                    rdfs:label "plannedTotal";
                    rdfs:range xsd:decimal;
                    <urn:fabric-internal:name> "plannedTotal".
fabric:previouslyApprovedEOTDays a owl:DatatypeProperty;
                                 rdfs:comment "Cumulative days approved under earlier claims.";
                                 rdfs:domain fabric:EOTClaim;
                                 rdfs:label "previouslyApprovedEOTDays";
                                 rdfs:range xsd:string;
                                 <urn:fabric-internal:name> "previouslyApprovedEOTDays".
fabric:progressUnit a owl:DatatypeProperty;
                    rdfs:comment "Whether planned and executed totals are percentages or monetary amounts.";
                    rdfs:domain fabric:ProgressReport;
                    rdfs:label "progressUnit";
                    rdfs:range xsd:string;
                    <urn:fabric-internal:name> "progressUnit".
fabric:recipient a owl:DatatypeProperty;
                 rdfs:comment "Name of the receiving organization or person, as written on the letter. Multi-valued (includes copied parties).";
                 rdfs:domain fabric:Letter;
                 rdfs:label "recipient";
                 rdfs:range xsd:string;
                 <urn:fabric-internal:name> "recipient".
fabric:reportDate a owl:DatatypeProperty;
                  rdfs:comment "Reporting date (yyyy-mm-dd). Planned and executed totals are recorded against this date.";
                  rdfs:domain fabric:ProgressReport;
                  rdfs:label "reportDate";
                  rdfs:range xsd:dateTime;
                  <urn:fabric-internal:name> "reportDate".
fabric:requestedEOTDays a owl:DatatypeProperty;
                        rdfs:domain fabric:EOTClaim;
                        rdfs:label "requestedEOTDays";
                        rdfs:range xsd:string;
                        <urn:fabric-internal:name> "requestedEOTDays".
fabric:revisedCompletionDate a owl:DatatypeProperty;
                             rdfs:domain fabric:EOTClaim;
                             rdfs:label "revisedCompletionDate";
                             rdfs:range xsd:dateTime;
                             <urn:fabric-internal:name> "revisedCompletionDate".
fabric:sender a owl:DatatypeProperty;
              rdfs:comment "Name of the sending organization or person, as written on the letter.";
              rdfs:domain fabric:Letter;
              rdfs:label "sender";
              rdfs:range xsd:string;
              <urn:fabric-internal:name> "sender".
fabric:siteHandoverDate a owl:DatatypeProperty;
                        rdfs:domain fabric:EOTClaim;
                        rdfs:label "siteHandoverDate";
                        rdfs:range xsd:dateTime;
                        <urn:fabric-internal:name> "siteHandoverDate".
fabric:subcontractorWitness a owl:DatatypeProperty;
                            rdfs:domain fabric:AgreementClause;
                            rdfs:label "subcontractorWitness";
                            rdfs:range xsd:string;
                            <urn:fabric-internal:name> "subcontractorWitness".
fabric:subject a owl:DatatypeProperty;
               rdfs:domain fabric:Letter;
               rdfs:label "subject";
               rdfs:range xsd:string;
               <urn:fabric-internal:name> "subject".
<urn:fabric-internal:namespace:default> a <urn:fabric-internal:Namespace>;
                                        rdfs:label "default".
